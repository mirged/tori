# Copy to .env and edit. Everything is optional for a plain classroom setup.

# Public server with HTTPS: your domain (its DNS A record must point at this server).
# DOMAIN=quiz.example.com

# Override the join address shown on the lobby screen and QR code.
# PUBLIC_URL=https://quiz.example.com   (without a domain: PUBLIC_URL=http://SERVER-IP)

# Host port for plain HTTP (default 80, the standard web port).
# PORT=80

# How long finished games are kept, and capacity limits.
# RETENTION_HOURS=24
# MAX_ROOMS=100
# MAX_PLAYERS=300
